generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model College {
  id                  String   @id @default(cuid())
  name                String
  location            String
  fees                Int
  rating              Float
  placementPercentage Int
  description         String
  image               String
  courses             String[]
  createdAt           DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())

  savedColleges SavedCollege[]
}

model SavedCollege {
  id        String   @id @default(cuid())
  userId    String
  collegeId String

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
